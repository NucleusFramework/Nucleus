# Native libraries (built on CI via build-natives.yaml)
**/src/main/resources/nucleus/native/

# MSVC build artifacts
*.obj
*.exp
*.lib
*.pdb

# Cargo / Rust build outputs (decorated-window-tao native crate)
**/native/target/

# Cargo registry metadata (vendored crates)
decorated-window-tao/src/main/native/vendor/**/.cargo_vcs_info.json
decorated-window-tao/src/main/native/vendor/**/.cargo-ok

# .NET build outputs (scripts/uia-listener)
**/bin/
**/obj/

# Scratch notes / problem briefs at repo root
/uia-problem.txt

# UIA debug log written by nucleus_tao_a11y.dll when NUCLEUS_TAO_A11Y_DEBUG=1
/tmp/nucleus_a11y.log

# IDE temporary lock files
.*~

# tao-demo Windows native build artifacts (NuGet-fetched WebView2 SDK,
# generated MSVC outputs)
examples/tao-demo/src/main/native/windows/packages/
examples/tao-demo/src/main/native/windows/nuget.exe
examples/tao-demo/src/main/native/windows/build_log.txt

# GraalVM native-image build output (agent metadata, static analysis, repo
# metadata). PGO profiles under graalvm/pgo/ are committed intentionally and
# kept trackable.
**/graalvm/reachability-metadata.json
**/graalvm/agentOutput/
**/graalvm/staticAnalysis/
**/graalvm/libraryMetadata/
**/graalvm/metadataRepoDirs.txt

# JVM crash logs
hs_err_pid*.log
replay_pid*.log
core.[0-9]*

# Machine-local Gradle property overrides (signing keys, etc.)
gradle-local.properties
