<?xml version="1.0" encoding="utf-8"?>
<!-- Slug "installers" in SignPath: the NSIS / portable .exe and the .msi electron-builder produced. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="**/*.exe" min-matches="0" max-matches="unbounded">
      <authenticode-sign />
    </pe-file>
    <msi-file path="**/*.msi" min-matches="0" max-matches="unbounded">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
