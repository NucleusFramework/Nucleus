<?xml version="1.0" encoding="utf-8"?>
<!--
  Slug "app-image" in SignPath. release-desktop.yaml uploads only the app image's still-unsigned
  launchers and DLLs (SignPath has no "skip if already signed", and append="false" would replace a
  vendor's signature), at their paths in the image.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="**/*.exe" min-matches="0" max-matches="unbounded" />
      <include path="**/*.dll" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
