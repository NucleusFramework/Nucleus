        <!-- Windows 11 widget provider (probe shell.windows-widgets). Appended verbatim inside <Extensions>:
             no ${} macro is expanded here. The CLSID must match NucleusWindowsWidgetsGateway.CLSID.
             Icon and screenshot paths are read as plain files by the widget host, not through resources.pri:
             they point at resources/common/widgets, never at the scale-qualified appx assets. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="app\NucleusLab.exe" Arguments="-RegisterProcessAsComServer" DisplayName="Nucleus Lab widget provider">
              <com:Class Id="439DB1E7-E547-4D7B-A0B4-DB4A0045B335" DisplayName="Nucleus Lab widget provider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" DisplayName="Nucleus Lab" Id="NucleusLabWidgets" PublicFolder="assets">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="app\app\resources\widgets\icon.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="439DB1E7-E547-4D7B-A0B4-DB4A0045B335" />
                </Activation>
                <Definitions>
                  <Definition Id="LabCounter" DisplayName="Lab counter" Description="A counter driven by the Nucleus Lab widget probe">
                    <Capabilities>
                      <Capability><Size Name="small" /></Capability>
                      <Capability><Size Name="medium" /></Capability>
                      <Capability><Size Name="large" /></Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="app\app\resources\widgets\icon.png" />
                      </Icons>
                      <!-- Picker preview: the medium card, 300 x 304 px, transparent rounded corners. -->
                      <Screenshots>
                        <Screenshot Path="app\app\resources\widgets\screenshot.png" DisplayAltText="Nucleus Lab counter" />
                      </Screenshots>
                      <DarkMode>
                        <Screenshots>
                          <Screenshot Path="app\app\resources\widgets\screenshot-dark.png" DisplayAltText="Nucleus Lab counter" />
                        </Screenshots>
                      </DarkMode>
                      <LightMode>
                        <Screenshots>
                          <Screenshot Path="app\app\resources\widgets\screenshot-light.png" DisplayAltText="Nucleus Lab counter" />
                        </Screenshots>
                      </LightMode>
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
