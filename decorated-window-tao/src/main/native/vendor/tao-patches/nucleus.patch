+    fn commit_is_queued(&self) -> bool {
+      self.commit_queued
+    }
+  }
+
+  /// Feeds one message and drops the `ProcResult` the caller would consume.
+  fn send(
+    handler: &mut ImeHandler,
+    source: &dyn ImeSource,
+    msg: u32,
+    wparam: usize,
+    lparam: isize,
