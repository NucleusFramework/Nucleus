+/// (`false`) handlers whenever the OS modal size/move loop starts or ends.
+/// See [`SIZE_MOVE_HOOK`].
+pub fn set_size_move_hook(hook: fn(crate::window::WindowId, bool)) {
+  let _ = SIZE_MOVE_HOOK.set(hook);
