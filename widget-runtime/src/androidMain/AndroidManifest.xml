<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Captures the application context before Application.onCreate, where the app declares
             its widgets with NucleusWidgets.start { }. -->
        <provider
            android:name="dev.nucleusframework.widget.android.WidgetContextProvider"
            android:authorities="${applicationId}.nucleus-widgets"
            android:exported="false" />
    </application>
</manifest>
